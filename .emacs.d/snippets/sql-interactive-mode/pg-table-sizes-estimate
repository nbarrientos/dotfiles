# -*- mode: snippet -*-
# name: PostgreSQL: show an estimate size of all tables
# key: pg-table-sizes-estimate
# condition: (progn (eq 'postgres sql-product))
# --
SELECT
    schemaname,
    relname AS table_name,
    n_live_tup AS row_count
FROM pg_stat_user_tables
WHERE schemaname = '${1:schema}'
ORDER BY row_count DESC;